#!/bin/bash
qemu-system-s390x -smp 6 -m 2048 -machine s390-ccw-virtio -cpu max,zpci=on -nographic \
                  -drive if=none,id=dr1,file=oracular-server-cloudimg-s390x.img \
                  -device virtio-blk,drive=dr1,bootindex=1 \
                  -netdev user,id=unet -device virtio-net-pci,netdev=unet
